# Rebuildable pipeline artifacts (see docs/09_current_state_and_known_issues.md):
# these are regenerated from data/processed/chunks/*.json by src/retrieval and
# src/generation on first run, and grow unboundedly with usage. Not source.
data/faiss/
data/retrieval_cache/
data/step5_cache/
data/retrieval_logs/
data/mlflow_artifacts/
mlflow.db
mlruns/

# Per-run eval output (src/evaluation/run_eval.py) — data/eval_baseline.json
# is the one eval artifact that IS committed (deliberately updated).
data/eval_results/

# Per-trace audit records written by app/api.py (src/observability/audit_store.py)
data/audit_log/

# Per-trace human-in-the-loop review records (src/observability/review_store.py)
data/review_log/

# client/api-types.ts and client/openapi.json ARE committed (see
# client/README.md) — only node_modules is a build artifact.
client/node_modules/
