FROM python:3.12-slim

WORKDIR /srv

# Build deps for faiss-cpu / pdfminer's native extensions.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY app ./app

# Install the project itself (editable-off) so `src.*`/`app.*` imports
# resolve the same way they do in local dev (see pyproject.toml's
# tool.setuptools.packages.find), not via a PYTHONPATH hack.
RUN pip install --no-cache-dir .

# data/processed (chunks, extracted text) is baked into the image so
# retrieval has something to build its FAISS index from on first run;
# data/faiss, data/*_cache, data/audit_log, data/mlflow_artifacts stay as
# runtime volumes (see docker-compose.yml) — same rebuildable-vs-source
# split as .gitignore documents for local dev.
COPY data/raw ./data/raw
COPY data/processed ./data/processed

EXPOSE 8000

CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000"]
