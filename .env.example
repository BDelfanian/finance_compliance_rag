# Copy to .env and fill in. All settings are read via src/config.py
# (pydantic-settings) — this file documents every field Settings exposes.
# Only OPENAI_API_KEY is required; everything else has a working default.

# -------------------------------
# OpenAI (required)
# -------------------------------
OPENAI_API_KEY=

# -------------------------------
# OpenAI models
# -------------------------------
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-5-mini

# -------------------------------
# Retrieval (src/retrieval/run_embeddings_retrieval.py)
# -------------------------------
# VECTOR_DIM=1536
# EMBEDDING_BATCH_SIZE=50
# K_NEAREST=5
# SIMILARITY_THRESHOLD=0.55

# -------------------------------
# Generation (src/generation/citation_bound_answer_generation.py)
# -------------------------------
# CITATION_TOP_K=5

# -------------------------------
# Paths (repo-root relative unless absolute)
# -------------------------------
# CHUNK_PATH=data/processed/chunks
# FAISS_PATH=data/faiss
# RETRIEVAL_CACHE_PATH=data/retrieval_cache
# STEP5_CACHE_PATH=data/step5_cache
# MLFLOW_ARTIFACT_ROOT=data/mlflow_artifacts

# -------------------------------
# MLflow (src/chains/step6_agent_wrappers_mlflow.py)
# -------------------------------
# Leave unset to use mlflow's own local default (sqlite:///mlflow.db in this
# repo). Set to point at the Dockerized tracking server instead:
#   docker compose -f docker/docker-compose.yml up -d
#   MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_URI=
# MLFLOW_EXPERIMENT_NAME=finance_compliance_rag_agents

# -------------------------------
# Orchestration
# -------------------------------
# MODEL_VERSION=gpt-4.1
